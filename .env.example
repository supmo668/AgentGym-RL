# Environment variables for AgentGym-RL

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
MODEL_NAME=gpt-4o-mini
MAX_ROUND=10

# Environment Selection (searchqa, alfworld, webshop, etc.)
ENV=searchqa

# Generic Port Configuration
# The environment server will use this port
ENV_PORT=36001

# Environment-Specific Configuration
# Generic base URL for environment server
ENV_SERVER_BASE=http://localhost:36001

# Environment-specific settings (set based on your ENV choice)
# For SearchQA:
SEARCHQA_FAISS_GPU=false
# For ALFWorld:
# ALFWORLD_SETTING=value
# For WebShop:
# WEBSHOP_SETTING=value

# Evaluation Configuration
# These will be constructed dynamically: ${ENV}_eval_sample.json
INFERENCE_FILE_SUFFIX=eval_sample.json
OUTPUT_DIR_PREFIX=eval_results

# Data Configuration
DATA_LEN=100
TIMEOUT=2400
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=1
