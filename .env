# Environment variables for AgentGym-RL

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
MODEL_NAME=gpt-4o-mini
MAX_ROUND=10

# Environment Selection
ENV=searchqa

# Port Configuration
SEARCHQA_PORT=36001
# ALFWORLD_PORT=36002
# WEBSHOP_PORT=36003

# SearchQA Environment Configuration
ENV_SERVER_BASE=http://localhost:36001
SEARCHQA_FAISS_GPU=false

# Evaluation Configuration
INFERENCE_FILE=searchqa_eval_sample.json
OUTPUT_DIR=eval_results_searchqa

# Data Configuration
DATA_LEN=100
TIMEOUT=2400
MAX_TOKENS=4096
TEMPERATURE=0.7
TOP_P=1
